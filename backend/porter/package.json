{
  "name": "porter-backend",
  "version": "1.0.0",
  "description": "Porter Request Management Backend Service",
  "type": "commonjs",
  "scripts": {
    "dev": "dotenv -e .env -e .env.local -- tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "start": "dotenv -e .env -e .env.local -- tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate --schema=../../shared/prisma/schema.prisma",
    "prisma:migrate": "prisma generate --schema=../../shared/prisma/schema.prisma && prisma migrate dev --schema=../../shared/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=../../shared/prisma/schema.prisma",
    "db:push:local": "dotenv -e .env.local -- npx prisma db push --schema=../../shared/prisma/schema.prisma"
  },
  "keywords": [
    "porter",
    "backend",
    "grpc"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "^24.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.11.4",
    "@grpc/proto-loader": "^0.7.13",
    "@prisma/adapter-mariadb": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "dotenv": "^17.2.3",
    "pino": "^9.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^24.10.1",
    "dotenv-cli": "^7.4.2",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-prettier": "5.2.1",
    "eslint-plugin-unused-imports": "4.1.4",
    "globals": "^16.0.0",
    "prettier": "^3.3.3",
    "prisma": "7.3.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.7.0"
  }
}
