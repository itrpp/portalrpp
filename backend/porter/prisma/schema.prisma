// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// ========================================
/// Porter Request Database Schema
/// ========================================

model PorterRequest {
  id           String   @id @default(cuid()) // รหัสของาน
  createdAt    DateTime @default(now()) // วันที่สร้างของาน
  updatedAt    DateTime @updatedAt // วันที่แก้ไขของาน
  status       String   @default("WAITING_CENTER") @db.VarChar(50) // สถานะของาน
  specialNotes String?  @db.Text // หมายเหตุเพิ่มเติม

  /// Requester Information
  requestedDateTime   DateTime // วันที่และเวลานัดของงาน
  requesterDepartment Int? // แผนกที่แจ้งงาน
  requesterUserID     String   @map("requester_user_id") // ผู้ใช้งานที่แจ้งงาน
  requesterName       String // ชื่อผู้แจ้งงาน
  requesterPhone      String   @db.VarChar(20) // หมายเลขโทรศัพท์ผู้แจ้งงาน

  /// Patient Information
  patientName      String // ชื่อผู้ป่วย
  patientHN        String @db.VarChar(50) // รหัสผู้ป่วย
  patientCondition Json? // สภาพผู้ป่วย

  /// Transport Meta
  urgencyLevel    String  @db.VarChar(50) // ระดับความด่วน
  vehicleType     String  @db.VarChar(50) // ประเภทรถ
  hasVehicle      String  @db.VarChar(50) // มีรถแล้วหรือยัง
  returnTrip      String  @db.VarChar(50) // ส่งกลับหรือไม่
  transportReason String  @db.VarChar(200) // เหตุผลการเคลื่อนย้าย
  equipment       Json // อุปกรณ์ที่ต้องการ
  equipmentOther  String? @db.VarChar(200) // อุปกรณ์อื่นๆ ระบุ

  /// Pickup Location
  pickupBuildingId        String // อาคารที่รับ
  pickupFloorDepartmentId String // หน่วยงานที่รับ
  pickupRoomBedName       String? // ห้องหรือเตียงที่รับ

  /// Delivery Location
  deliveryBuildingId        String // อาคารที่ส่ง
  deliveryFloorDepartmentId String // หน่วยงานที่ส่ง
  deliveryRoomBedName       String? // ห้องหรือเตียงที่ส่ง

  acceptedById String?   @db.VarChar(200) // รหัสผู้ที่หมายงาน (ศูนย์เปล)
  acceptedAt   DateTime? // วันที่และเวลาที่มอบหมายงาน
  assignedToId String? // รหัสผู้ปฏิบัติงานที่ได้รับมอบหมายงาน (เจ้าหน้าที่เปล)
  assignedAt   DateTime? // วันที่และเวลาที่รับงาน

  pickupAt   DateTime? // วันที่และเวลาที่ถึงจุดรับ
  deliveryAt DateTime? // วันที่และเวลาที่ถึงจุดส่ง
  returnAt   DateTime? // วันที่และเวลาที่ถึงจุดส่งกลับ

  completedAt     DateTime? // วันที่และเวลาที่เสร็จสิ้นงาน
  cancelledAt     DateTime? // วันที่และเวลาที่ยกเลิกงาน
  cancelledReason String?   @db.Text // เหตุผลการยกเลิกงาน
  cancelledById   String?   @db.VarChar(200) // รหัสผู้ยกเลิกงาน

  @@index([status])
  @@index([urgencyLevel])
  @@index([requestedDateTime])
  @@index([createdAt])
  @@index([assignedToId])
}

/// ========================================
/// Location Settings Schema
/// ========================================
model Building {
  id         String   @id @default(cuid())
  name       String   @db.VarChar(200)
  floorCount Int?
  status     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  floors     FloorDepartment[]
  floorPlans FloorPlan[]

  @@index([name])
  @@index([status])
  @@index([createdAt])
}

model FloorDepartment {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(200)
  buildingId  String
  floorNumber Int?
  status      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  departmentType Int?
  roomType       Int?
  roomCount      Int?
  bedCount       Int?

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@index([buildingId])
  @@index([departmentType])
  @@index([status])
}

model FloorPlan {
  id          String   @id @default(cuid())
  buildingId  String
  floorNumber Int
  imageData   String   @db.LongText // base64 string
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  building Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  stations BleStation[]

  @@unique([buildingId, floorNumber])
  @@index([buildingId, floorNumber])
}

model BleStation {
  id             String   @id @default(cuid())
  floorPlanId    String
  name           String   @db.VarChar(200)
  macAddress     String   @unique @db.VarChar(17) // MAC address format: XX:XX:XX:XX:XX:XX
  uuid           String?  @db.VarChar(36) // UUID format
  positionX      Float
  positionY      Float
  signalStrength Int? // dBm
  batteryLevel   Int? // percentage (0-100)
  status         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  floorPlan FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)

  @@index([floorPlanId])
}

/// ========================================
/// Employee Management Schema
/// ========================================
model PorterEmployee {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  citizenId    String  @unique @db.VarChar(13)
  firstName    String  @db.VarChar(100)
  lastName     String  @db.VarChar(100)
  nickname     String? @db.VarChar(100) // ชื่อเล่น
  profileImage String? @db.LongText // รูปภาพโปรไฟล์ (base64 string) - ใช้ LONGTEXT สำหรับรองรับ base64 ที่ยาว

  employmentTypeId Int // ชี้ไปที่ hrd_person_type.HR_PERSON_TYPE_ID
  positionId       Int // ชี้ไปที่ hrd_position.HR_POSITION_ID

  status Boolean @default(true)
  userId String? @map("user_id") // map กับ user login (id จาก User table)

  // หมายเหตุ: ไม่สามารถสร้าง foreign key relation กับ hrd tables ได้เพราะอยู่ใน database อื่น
  // ต้องดึงข้อมูลจาก hrd tables แบบ manual ที่ service layer

  @@index([citizenId])
  @@index([status])
  @@index([employmentTypeId])
  @@index([positionId])
  @@index([userId])
}
